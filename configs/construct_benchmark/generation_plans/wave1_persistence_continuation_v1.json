{
  "schema_version": "0.1.0",
  "plan_id": "wave1_persistence_continuation_prompts_v1",
  "construct_id": "persistence_continuation",
  "construct_spec_path": "../constructs/persistence_continuation_v1.json",
  "wave": 1,
  "task_composition": {
    "prompt_order": "probe_then_downstream",
    "probe_context": "paired_probe_only",
    "downstream_context": "independent_behavior_task_only",
    "condition_carryover": "state_only",
    "surface_text_carryover": "none",
    "behavior_steering_pool_separation": true
  },
  "default_count_per_cell_per_model": 2,
  "run_modes": {
    "review": {
      "purpose": "prompt_review",
      "count_per_model_per_cell": 1,
      "partial": true
    },
    "full": {
      "purpose": "frozen_full_inventory",
      "count_per_model_per_cell": null,
      "partial": false
    }
  },
  "models": [
    {"alias": "gpt54", "model": "openai/gpt-5.4"},
    {"alias": "sonnet", "model": "anthropic/claude-sonnet-4-7"}
  ],
  "generation": {
    "temperature": 0.7,
    "max_tokens": 2500,
    "seed": 104,
    "timeout": 120,
    "retries": 0,
    "max_items_per_request": 2,
    "estimated_input_tokens_per_request": 1400,
    "estimated_output_tokens_per_record": 300
  },
  "design_rules": [
    "Manipulate retaining the focal goal, not blindly preserving a fixed plan or refusing to adapt means.",
    "Do not use the construct ID, condition IDs, or labels such as continue or abandon in prompt_text.",
    "Probe and downstream content pools must use different goals, actors, and setback types.",
    "Do not infer or alter the preregistered readout sign from generated prose."
  ],
  "forbidden_terms": ["persistence_continuation", "continue_goal", "abandon_goal", "persistence", "abandonment"],
  "content_pools": {
    "persistence_probe_train": {"role": "probe", "domains": ["garden_projects", "language_learning"]},
    "persistence_probe_validation": {"role": "probe", "domains": ["community_events", "craft_projects"]},
    "persistence_probe_heldout": {"role": "probe", "domains": ["field_research", "small_business_projects"]},
    "persistence_behavior": {"role": "behavior", "domains": ["new_resource_allocation_items"]},
    "persistence_steering": {"role": "steering", "domains": ["new_resource_allocation_items_heldout"]},
    "persistence_calibration": {"role": "calibration", "domains": ["neutral_resource_allocation_items"]}
  },
  "behavior_factor_schedule": {
    "note": "All three behavior-task factors must vary independently. Generate one item per combination; do not allow factors to co-vary. Record setback_severity, goal_value, and means_viable as structured metadata fields on every generated item.",
    "factors": {
      "setback_severity": ["moderate", "severe"],
      "goal_value":       ["high", "low"],
      "means_viable":     [true, false]
    },
    "required_combinations": [
      {"setback_severity": "moderate", "goal_value": "high", "means_viable": true},
      {"setback_severity": "moderate", "goal_value": "high", "means_viable": false},
      {"setback_severity": "moderate", "goal_value": "low",  "means_viable": true},
      {"setback_severity": "moderate", "goal_value": "low",  "means_viable": false},
      {"setback_severity": "severe",   "goal_value": "high", "means_viable": true},
      {"setback_severity": "severe",   "goal_value": "high", "means_viable": false},
      {"setback_severity": "severe",   "goal_value": "low",  "means_viable": true},
      {"setback_severity": "severe",   "goal_value": "low",  "means_viable": false}
    ],
    "required_item_fields": ["setback_severity", "goal_value", "means_viable"],
    "balance_check": "Each of the 8 combinations must appear at least once per content pool (behavior_eval and steering_eval). Warn if any combination is missing."
  },
  "cells": [
    {
      "cell_id": "probe_train",
      "split": "direction_train",
      "prompt_role": "probe",
      "mode": "paired",
      "prompt_family": "persistence_probe_train",
      "content_pool": "persistence_probe_train",
      "condition_ids": ["continue_goal", "abandon_goal"],
      "instructions": "Generate matched goal-pursuit scenarios. Within each pair, hold setback severity, goal value, and means viability constant — the only thing that changes is whether the focal goal is framed as worth continuing or worth abandoning. Do not allow any nuisance factor to co-vary with the condition."
    },
    {
      "cell_id": "probe_validation",
      "split": "direction_validation",
      "prompt_role": "probe",
      "mode": "paired",
      "prompt_family": "persistence_probe_validation",
      "content_pool": "persistence_probe_validation",
      "condition_ids": ["continue_goal", "abandon_goal"],
      "instructions": "Use new goals and setback types while preserving the focal-goal contrast. Setback severity, goal value, and means viability must remain constant within each pair."
    },
    {
      "cell_id": "probe_heldout",
      "split": "direction_heldout",
      "prompt_role": "probe",
      "mode": "paired",
      "prompt_family": "persistence_probe_heldout",
      "content_pool": "persistence_probe_heldout",
      "condition_ids": ["continue_goal", "abandon_goal"],
      "instructions": "Use held-out domains and avoid template phrases from train or validation prompts. Setback severity, goal value, and means viability must remain constant within each pair."
    },
    {
      "cell_id": "behavior_eval",
      "split": "behavior_eval",
      "prompt_role": "behavior",
      "mode": "single",
      "prompt_family": "persistence_behavior_eval",
      "content_pool": "persistence_behavior",
      "condition_id": "neutral",
      "task_id": "resource_reallocation_v1",
      "parser_id": "two_integers_sum_100_v1",
      "expected_output_format": "two_integers_sum_100",
      "factor_schedule": "behavior_factor_schedule",
      "count_per_model": 8,
      "category_balance": {
        "setback_severity": ["moderate", "moderate", "moderate", "moderate", "severe", "severe", "severe", "severe"],
        "goal_value": ["high", "high", "low", "low", "high", "high", "low", "low"],
        "means_viable": [true, false, true, false, true, false, true, false]
      },
      "instructions": "Generate one independent effort-allocation item per combination in behavior_factor_schedule.required_combinations (8 items minimum). Use new goals, actors, domains, and setback types not present in probe prompts. Record setback_severity, goal_value, and means_viable as structured metadata fields on every item. Do not allow factors to co-vary — each combination must appear in isolation. Do not ask the model to label persistence or abandonment."
    },
    {
      "cell_id": "steering_eval",
      "split": "steering_eval",
      "prompt_role": "steering",
      "mode": "single",
      "prompt_family": "persistence_steering_eval",
      "content_pool": "persistence_steering",
      "condition_id": "neutral",
      "task_id": "resource_reallocation_v1",
      "parser_id": "two_integers_sum_100_v1",
      "expected_output_format": "two_integers_sum_100",
      "factor_schedule": "behavior_factor_schedule",
      "count_per_model": 8,
      "category_balance": {
        "setback_severity": ["moderate", "moderate", "moderate", "moderate", "severe", "severe", "severe", "severe"],
        "goal_value": ["high", "high", "low", "low", "high", "high", "low", "low"],
        "means_viable": [true, false, true, false, true, false, true, false]
      },
      "instructions": "Generate one independent intervention item per combination in behavior_factor_schedule.required_combinations (8 items minimum). Content must be distinct from behavior_eval. Record setback_severity, goal_value, and means_viable as structured metadata fields on every item."
    },
    {
      "cell_id": "calibration",
      "split": "calibration",
      "prompt_role": "calibration",
      "mode": "single",
      "prompt_family": "persistence_calibration",
      "content_pool": "persistence_calibration",
      "condition_id": "neutral",
      "task_id": "resource_reallocation_v1",
      "parser_id": "two_integers_sum_100_v1",
      "expected_output_format": "two_integers_sum_100",
      "count_per_model": 8,
      "category_balance": {
        "setback_severity": ["moderate", "moderate", "moderate", "moderate", "severe", "severe", "severe", "severe"],
        "goal_value": ["high", "high", "low", "low", "high", "high", "low", "low"],
        "means_viable": [true, false, true, false, true, false, true, false]
      },
      "instructions": "Generate neutral calibration items used only to estimate within-cell output variation. No factor-schedule constraint required here."
    }
  ]
}
