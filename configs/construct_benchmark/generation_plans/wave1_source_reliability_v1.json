{
  "schema_version": "0.1.0",
  "plan_id": "wave1_source_reliability_prompts_v1",
  "construct_id": "source_reliability",
  "construct_spec_path": "../constructs/source_reliability_v1.json",
  "wave": 1,
  "task_composition": {
    "prompt_order": "probe_then_downstream",
    "probe_context": "paired_probe_only",
    "downstream_context": "independent_behavior_task_only",
    "condition_carryover": "state_only",
    "surface_text_carryover": "none",
    "behavior_steering_pool_separation": true
  },
  "default_count_per_cell_per_model": 2,
  "run_modes": {
    "review": {
      "purpose": "prompt_review",
      "count_per_model_per_cell": 1,
      "partial": true
    },
    "full": {
      "purpose": "frozen_full_inventory",
      "count_per_model_per_cell": null,
      "partial": false
    }
  },
  "models": [
    {"alias": "gpt54", "model": "openai/gpt-5.4"},
    {"alias": "sonnet", "model": "anthropic/claude-sonnet-4-7"}
  ],
  "generation": {
    "temperature": 0.7,
    "max_tokens": 2500,
    "seed": 103,
    "timeout": 120,
    "retries": 0,
    "max_items_per_request": 2,
    "estimated_input_tokens_per_request": 1400,
    "estimated_output_tokens_per_record": 300
  },
  "design_rules": [
    "Manipulate source track record, not authority, status, or general social compliance.",
    "Do not use the construct ID, condition IDs, or labels such as reliable source in prompt_text.",
    "Probe and downstream content pools must use different source names and factual domains.",
    "Do not infer or alter the preregistered readout sign from generated prose."
  ],
  "forbidden_terms": ["source_reliability", "reliable_source", "unreliable_source", "source reliability"],
  "content_pools": {
    "source_probe_train": {"role": "probe", "domains": ["local_history", "weather_records"]},
    "source_probe_validation": {"role": "probe", "domains": ["museum_catalogs", "crop_reports"]},
    "source_probe_heldout": {"role": "probe", "domains": ["shipping_logs", "wildlife_surveys"]},
    "source_behavior": {"role": "behavior", "domains": ["new_testimony_items"]},
    "source_steering": {"role": "steering", "domains": ["new_testimony_items_heldout"]},
    "source_calibration": {"role": "calibration", "domains": ["neutral_testimony_items"]}
  },
  "behavior_factor_schedule": {
    "note": "All three behavior-task factors must vary independently. Generate one item per combination; do not allow factors to co-vary. Record testimony_valence, authority_status, and evidence_quality as structured metadata fields on every generated item.",
    "factors": {
      "testimony_valence":  ["supporting", "contradicting"],
      "authority_status":   ["legitimate", "non_authority"],
      "evidence_quality":   ["strong", "weak"]
    },
    "required_combinations": [
      {"testimony_valence": "supporting",    "authority_status": "legitimate",    "evidence_quality": "strong"},
      {"testimony_valence": "supporting",    "authority_status": "legitimate",    "evidence_quality": "weak"},
      {"testimony_valence": "supporting",    "authority_status": "non_authority", "evidence_quality": "strong"},
      {"testimony_valence": "supporting",    "authority_status": "non_authority", "evidence_quality": "weak"},
      {"testimony_valence": "contradicting", "authority_status": "legitimate",    "evidence_quality": "strong"},
      {"testimony_valence": "contradicting", "authority_status": "legitimate",    "evidence_quality": "weak"},
      {"testimony_valence": "contradicting", "authority_status": "non_authority", "evidence_quality": "strong"},
      {"testimony_valence": "contradicting", "authority_status": "non_authority", "evidence_quality": "weak"}
    ],
    "required_item_fields": ["testimony_valence", "authority_status", "evidence_quality"],
    "balance_check": "Each of the 8 combinations must appear at least once per content pool (behavior_eval and steering_eval). Warn if any combination is missing."
  },
  "cells": [
    {
      "cell_id": "probe_train",
      "split": "direction_train",
      "prompt_role": "probe",
      "mode": "paired",
      "prompt_family": "source_probe_train",
      "content_pool": "source_probe_train",
      "condition_ids": ["reliable_source", "unreliable_source"],
      "instructions": "Generate matched source-track-record scenarios. Keep authority status and evidence quality controlled and constant within each pair — do not allow them to co-vary with the track-record condition."
    },
    {
      "cell_id": "probe_validation",
      "split": "direction_validation",
      "prompt_role": "probe",
      "mode": "paired",
      "prompt_family": "source_probe_validation",
      "content_pool": "source_probe_validation",
      "condition_ids": ["reliable_source", "unreliable_source"],
      "instructions": "Use new factual domains and source names while preserving the track-record contrast. Authority status and evidence quality must remain constant within each pair."
    },
    {
      "cell_id": "probe_heldout",
      "split": "direction_heldout",
      "prompt_role": "probe",
      "mode": "paired",
      "prompt_family": "source_probe_heldout",
      "content_pool": "source_probe_heldout",
      "condition_ids": ["reliable_source", "unreliable_source"],
      "instructions": "Use held-out domains and avoid template phrases from train or validation prompts. Authority status and evidence quality must remain constant within each pair."
    },
    {
      "cell_id": "behavior_eval",
      "split": "behavior_eval",
      "prompt_role": "behavior",
      "mode": "single",
      "prompt_family": "source_behavior_eval",
      "content_pool": "source_behavior",
      "condition_id": "neutral",
      "task_id": "testimony_weighting_v1",
      "parser_id": "single_integer_probability_v1",
      "expected_output_format": "single_integer_0_to_100",
      "factor_schedule": "behavior_factor_schedule",
      "count_per_model": 8,
      "category_balance": {
        "testimony_valence": ["supporting", "supporting", "supporting", "supporting", "contradicting", "contradicting", "contradicting", "contradicting"],
        "authority_status": ["legitimate", "legitimate", "non_authority", "non_authority", "legitimate", "legitimate", "non_authority", "non_authority"],
        "evidence_quality": ["strong", "weak", "strong", "weak", "strong", "weak", "strong", "weak"]
      },
      "instructions": "Generate one independent testimony-weighting item per combination in behavior_factor_schedule.required_combinations (8 items minimum). Use new source names, domains, and claims not present in probe prompts. Record testimony_valence, authority_status, and evidence_quality as structured metadata fields on every item. Do not allow factors to co-vary — each combination must appear in isolation."
    },
    {
      "cell_id": "steering_eval",
      "split": "steering_eval",
      "prompt_role": "steering",
      "mode": "single",
      "prompt_family": "source_steering_eval",
      "content_pool": "source_steering",
      "condition_id": "neutral",
      "task_id": "testimony_weighting_v1",
      "parser_id": "single_integer_probability_v1",
      "expected_output_format": "single_integer_0_to_100",
      "factor_schedule": "behavior_factor_schedule",
      "count_per_model": 8,
      "category_balance": {
        "testimony_valence": ["supporting", "supporting", "supporting", "supporting", "contradicting", "contradicting", "contradicting", "contradicting"],
        "authority_status": ["legitimate", "legitimate", "non_authority", "non_authority", "legitimate", "legitimate", "non_authority", "non_authority"],
        "evidence_quality": ["strong", "weak", "strong", "weak", "strong", "weak", "strong", "weak"]
      },
      "instructions": "Generate one independent intervention item per combination in behavior_factor_schedule.required_combinations (8 items minimum). Content must be distinct from behavior_eval. Record testimony_valence, authority_status, and evidence_quality as structured metadata fields on every item."
    },
    {
      "cell_id": "calibration",
      "split": "calibration",
      "prompt_role": "calibration",
      "mode": "single",
      "prompt_family": "source_calibration",
      "content_pool": "source_calibration",
      "condition_id": "neutral",
      "task_id": "testimony_weighting_v1",
      "parser_id": "single_integer_probability_v1",
      "expected_output_format": "single_integer_0_to_100",
      "count_per_model": 8,
      "category_balance": {
        "testimony_valence": ["supporting", "supporting", "supporting", "supporting", "contradicting", "contradicting", "contradicting", "contradicting"],
        "authority_status": ["legitimate", "legitimate", "non_authority", "non_authority", "legitimate", "legitimate", "non_authority", "non_authority"],
        "evidence_quality": ["strong", "weak", "strong", "weak", "strong", "weak", "strong", "weak"]
      },
      "instructions": "Generate neutral calibration items used only to estimate within-cell output variation. No factor-schedule constraint required here."
    }
  ]
}
